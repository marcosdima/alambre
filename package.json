{
  "name": "alambre-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:fast": "pnpm --filter alambre test:fast",
    "test:behaviors": "pnpm --filter alambre test:behaviors",
    "test:core": "pnpm --filter alambre test:core",
    "test:hooks": "pnpm --filter alambre test:hooks",
    "test:relay": "pnpm --filter alambre test:relay",
    "test:ui": "pnpm --filter alambre test:ui",
    "test:api": "pnpm --filter alambre test:api",
    "check:quick": "pnpm --filter alambre check:quick",
    "test:e2e": "scripts/e2e.sh",
    "validate": "pnpm -r typecheck && pnpm -r lint && pnpm --filter alambre test && pnpm build",
    "relay:server": "node packages/alambre/scripts/relay-server.mjs",
    "publish:stage": "pnpm build && pnpm --filter alambre publish --tag stage --no-git-checks",
    "eas": "pnpm exec eas",
    "eas:login": "pnpm exec eas login"
  },
  "devDependencies": {
    "eas-cli": "^24.6.0"
  },
  "dependencies": {
    "expo-clipboard": "~8.0.8"
  }
}
