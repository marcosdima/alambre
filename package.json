{
  "name": "alambre-monorepo",
  "version": "0.0.0",
  "private": false,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "scripts/e2e.sh",
    "validate": "pnpm -r typecheck && pnpm -r lint && pnpm --filter alambre test && pnpm build",
    "relay:server": "node packages/room-relay/scripts/relay-server.mjs",
    "eas": "pnpm exec eas",
    "eas:login": "pnpm exec eas login"
  },
  "devDependencies": {
    "eas-cli": "^24.6.0"
  },
  "dependencies": {
    "expo-clipboard": "~8.0.8"
  }
}
