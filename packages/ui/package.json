{
  "name": "@some-alambre/ui",
  "version": "1.1.0",
  "type": "module",
  "description": "Tactile, accessible mobile UI components and design tokens built on alambre.",
  "main": "dist/module/index.js",
  "types": "dist/typescript/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Marcos Di Matteo Brambilla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosdima/alambre"
  },
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "alambre": ">=1.1.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@react-native/babel-preset": "^0.88.0",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "alambre": "workspace:*",
    "eslint": "9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "typescript": "~5.9.2"
  }
}
