{
  "name": "alambre",
  "version": "1.3.0",
  "description": "Tactile mobile UI kit, headless primitives, kinetic physics, and real-time room relay for React Native & Expo.",
  "type": "module",
  "main": "dist/module/index.js",
  "types": "dist/typescript/index.d.ts",
  "files": [
    "dist",
    "src",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./ui": {
      "types": "./dist/typescript/ui/index.d.ts",
      "default": "./dist/module/ui/index.js"
    },
    "./relay": {
      "types": "./dist/typescript/relay/index.d.ts",
      "default": "./dist/module/relay/index.js"
    },
    "./relay/partykit": {
      "types": "./dist/typescript/relay/partykit.d.ts",
      "default": "./dist/module/relay/partykit.js"
    },
    "./room-relay": {
      "types": "./dist/typescript/relay/index.d.ts",
      "default": "./dist/module/relay/index.js"
    },
    "./room-relay/partykit": {
      "types": "./dist/typescript/relay/partykit.d.ts",
      "default": "./dist/module/relay/partykit.js"
    },
    "./package.json": "./package.json"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "author": "Marcos Di Matteo Brambilla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosdima/alambre"
  },
  "bugs": {
    "url": "https://github.com/marcosdima/alambre/issues"
  },
  "homepage": "https://github.com/marcosdima/alambre#readme",
  "scripts": {
    "lint": "eslint .",
    "build": "bob build",
    "build:icons": "node scripts/generate-icons.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "check:quick": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fast": "vitest run --bail 1",
    "test:behaviors": "vitest run tests/behaviors",
    "test:core": "vitest run tests/core tests/capabilities",
    "test:hooks": "vitest run tests/hooks",
    "test:relay": "vitest run tests/relay",
    "test:ui": "vitest run tests/ui",
    "test:api": "vitest run tests/public-api.test.ts"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "expo-clipboard": "~8.0.8",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=13.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@react-native/babel-preset": "^0.87.1",
    "@tanstack/react-query": "5.91.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.4",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-clipboard": "~57.0.2",
    "jsdom": "^26.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11",
    "vitest-native": "^0.13.0",
    "ws": "^8.22.0"
  },
  "private": false,
  "keywords": [
    "react-native",
    "expo",
    "animation",
    "gesture-handler",
    "reanimated",
    "worklets",
    "library",
    "ui",
    "multiplayer",
    "room-relay",
    "partykit"
  ],
  "dependencies": {
    "svg-path-properties": "^2.1.0"
  }
}
