{
  "name": "alambre",
  "version": "1.1.1",
  "description": "Several simple react-native code solutions.",
  "type": "module",
  "main": "dist/module/index.js",
  "types": "dist/typescript/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "author": "Marcos Di Matteo Brambilla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosdima/alambre"
  },
  "bugs": {
    "url": "https://github.com/marcosdima/alambre/issues"
  },
  "homepage": "https://github.com/marcosdima/alambre#readme",
  "scripts": {
    "lint": "eslint .",
    "build": "bob build",
    "build:icons": "node scripts/generate-icons.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "expo-clipboard": "~8.0.8",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=13.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@react-native/babel-preset": "^0.87.1",
    "@tanstack/react-query": "5.91.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.4",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-clipboard": "~57.0.2",
    "jsdom": "^26.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11",
    "vitest-native": "^0.13.0"
  },
  "private": false,
  "keywords": [
    "react-native",
    "expo",
    "animation",
    "gesture-handler",
    "reanimated",
    "worklets",
    "library"
  ],
  "dependencies": {
    "svg-path-properties": "^2.1.0"
  }
}
