{
  "name": "alambre",
  "version": "1.0.4",
  "description": "Several simple react-native code solutions.",
  "type": "module",
  "main": "index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "author": "Marcos Di Matteo Brambilla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosdima/alambre"
  },
  "bugs": {
    "url": "https://github.com/marcosdima/alambre/issues"
  },
  "homepage": "https://github.com/marcosdima/alambre#readme",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.build.json && npm pack && rm -rf dist"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=13.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.91.2",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo": "54.0.33",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.3",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "typescript": "~5.9.2"
  },
  "private": false,
  "keywords": [
    "react-native",
    "expo",
    "animation",
    "gesture-handler",
    "reanimated",
    "worklets",
    "library"
  ]
}
