{
  "name": "@some-alambre/room-relay",
  "version": "1.0.0",
  "type": "module",
  "description": "Lightweight, headless ephemeral room relay for real-time multiplayer and multi-device state synchronization.",
  "main": "dist/module/index.js",
  "types": "dist/typescript/index.d.ts",
  "files": [
    "dist",
    "src",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./partykit": {
      "types": "./dist/typescript/partykit.d.ts",
      "default": "./dist/module/partykit.js"
    },
    "./package.json": "./package.json"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Marcos Di Matteo Brambilla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosdima/alambre"
  },
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "server": "node scripts/relay-server.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@react-native/babel-preset": "^0.88.0",
    "@types/react": "~19.2.4",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "react": "19.2.3",
    "react-native-builder-bob": "^0.43.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  }
}
